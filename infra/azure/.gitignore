# Ignore parameter files with actual secrets
*.local.json

# Ignore deployment logs
deployment-*.log

# Bicep build artifacts (generated JSON files)
main.json
core.json
modules/*.json
# Un-ignore bicepconfig.json in modules/ (it's a config file, not a build artifact)
!modules/bicepconfig.json
